# Copy this file to .env and fill in real values.
# Nothing here has a hardcoded secret default in config.py -- leaving a
# variable unset degrades to a safe/explicit dev-mode behavior (logged as
# a startup warning), never a silent placeholder credential.

# --- API keys / tenancy ------------------------------------------------
# Comma-separated "tenant_id:key" pairs. Leave empty to disable auth for
# local development (a warning is logged at startup when this happens).
# Example: API_KEYS=acme_logistics:sk_live_abc123,zippy_foods:sk_live_def456
API_KEYS=

# --- CORS ----------------------------------------------------------------
# Comma-separated allowed origins. "*" is fine for local dev only.
CORS_ALLOW_ORIGINS=*

# --- Geocoding -----------------------------------------------------------
GEOCODING_PROVIDER=nominatim
GEOCODE_TIMEOUT_SECONDS=10.0

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_RPM=60

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# Set to true only for local debugging -- logs full raw address text otherwise redacted.
LOG_FULL_ADDRESS_TEXT=false
